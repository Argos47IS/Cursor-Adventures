# ==================================================
# Telegram API (обязательно)
# Получить на https://my.telegram.org/apps
# ==================================================
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ==================================================
# Session String (обязательно)
# Сгенерировать: python generate_session.py
# ==================================================
SESSION_STRING=1BVtsOH...длинная_строка...

# ==================================================
# Telegram Bot (для уведомлений)
# Создать бота: @BotFather в Telegram
# Узнать chat_id: @userinfobot
# ==================================================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# ==================================================
# Google Sheets (опционально)
# Путь к JSON-файлу, base64-строка или сырой JSON
# ==================================================
GOOGLE_SA_CREDENTIALS=service_account.json
GOOGLE_SHEET_NAME=TG_Advertisers

# ==================================================
# Каналы для мониторинга
# Через запятую ИЛИ файл channels.txt
# ==================================================
# MONITORED_CHANNELS=durov,telegram,habr_com,vc_ru
CHANNELS_FILE=channels.txt

# ==================================================
# Настройки задержек (секунды)
# ==================================================
MIN_DELAY=3
MAX_DELAY=8

# ==================================================
# Максимум каналов за один запуск
# ==================================================
MAX_CHANNELS=300
