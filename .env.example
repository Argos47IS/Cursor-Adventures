# TGStat API token (required)
# Get your token at https://api.tgstat.ru/
TGSTAT_API_TOKEN=your_tgstat_api_token_here

# Google Sheets settings (optional — if not set, results are saved to CSV)
# Path to Google service account JSON key file
GOOGLE_CREDENTIALS_FILE=credentials.json
# Google Sheets spreadsheet ID (from the URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Worksheet name inside the spreadsheet
GOOGLE_SHEET_NAME=Telegram Channels

# Schedule time in MSK (HH:MM format)
SCHEDULE_TIME=16:00

# Minimum subscribers for channel filter
MIN_SUBSCRIBERS=5000
# Maximum subscribers for channel filter
MAX_SUBSCRIBERS=40000

# Number of days to look back for ad purchases
AD_LOOKBACK_DAYS=7

# CSV output path (used as fallback if Google Sheets is not configured)
CSV_OUTPUT_PATH=channels_report.csv
